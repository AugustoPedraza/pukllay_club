<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="PukllayClub" suffix=" · PukllayClub" phx-no-format>{assigns[:page_title]}</.live_title>
    <PukllayClubWeb.SEOTags.seo_tags seo={assigns[:seo]} />
    {if assigns[:csp_nonce] do
      PukllayClubWeb.SEO.json_ld_tag(
        PukllayClubWeb.SEO.local_business_json(),
        assigns[:csp_nonce]
      )
    end}
    {if assigns[:seo] && assigns[:seo][:json_ld] && assigns[:csp_nonce] do
      PukllayClubWeb.SEO.json_ld_tag(assigns[:seo][:json_ld], assigns[:csp_nonce])
    end}
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script phx-track-static type="text/javascript" src={~p"/assets/js/theme.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
