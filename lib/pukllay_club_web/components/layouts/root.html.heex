<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="PukllayClub" suffix=" · PukllayClub" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script phx-track-static type="text/javascript" src={~p"/assets/js/theme.js"}>
    </script>
  </head>
  <body class="pk-app-shell">
    {@inner_content}
  </body>
</html>
