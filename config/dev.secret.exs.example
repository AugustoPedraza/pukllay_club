# Template for config/dev.secret.exs — copy this file to config/dev.secret.exs
# (gitignored) and fill in real values before running the D-02 catalog seed
# pipeline locally:
#
#     cp config/dev.secret.exs.example config/dev.secret.exs
#
# See PukllayClub.Catalog.Seed.Credentials for how these values are resolved
# (environment variable first, then this Application config).
import Config

config :pukllay_club, PukllayClub.Catalog.Seed,
  bgg_api_token: "...",
  r2_account_id: "...",
  r2_access_key_id: "...",
  r2_secret_access_key: "...",
  r2_catalog_bucket: "pukllay-club-catalog",
  r2_public_base_url: "https://<something>.r2.dev",
  # Optional. Powers the one-off Spanish description translation job
  # (mix catalog.translate_descriptions, 01.3-03 D-01) only — every other
  # seed task runs fine without it. Get a key from Google AI Studio's
  # API-key page: https://aistudio.google.com/apikey
  gemini_api_key: "..."
