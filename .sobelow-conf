[
  exit: true,
  format: "txt",
  ignore_files: [],
  # Reviewed exceptions only — add here after manually confirming a finding is a
  # false positive or an intentionally deferred item, never preemptively.
  #
  # Config.CSP: Phoenix's put_secure_browser_headers does not set a
  # Content-Security-Policy by default (it is app-specific). Closed in Phase 1
  # (01-06): PukllayClubWeb.CSP.policy/0 builds the header value, and the
  # router's :browser pipeline applies it via the private put_csp/2 plug
  # (lib/pukllay_club_web/router.ex) immediately after
  # put_secure_browser_headers. Sobelow's Config.CSP check only inspects
  # put_secure_browser_headers' own call arguments statically and cannot
  # observe a header set by a separate plug, which is exactly why this
  # exemption still needs to exist rather than the finding just clearing
  # itself. Backed by a real test asserting the header on a live response:
  # test/pukllay_club_web/live/catalog_live_test.exs. Reviewed 2026-08-11.
  ignore: ["Config.CSP"],
  out: nil,
  private: false,
  router: nil,
  # skip: true makes sobelow honor function-level inline `# sobelow_skip
  # ["Submodule"]` annotations (and a skips-fingerprint file, which this
  # project deliberately does not have — no .sobelow-skips exists).
  # Annotated functions, all reviewed for WINDOWS #1 (2026-09-12):
  #   - PukllayClub.Catalog.Seed.CsvImport.stream_rows/1
  #   - PukllayClub.Catalog.Seed.CsvImport.header_row/1 (private)
  #   - PukllayClub.Catalog.Seed.Report.write!/2
  # These cover the four Traversal.FileModule findings from WINDOWS #1 — all
  # four paths are operator-supplied seed tooling input (CLI-run `mix
  # catalog.seed`, or test fixtures), never web input. A function-level skip
  # was chosen over adding Traversal.FileModule to the project-wide `ignore`
  # list above so any future web-reachable traversal bug in another module
  # would still be caught. Reviewed 2026-09-12.
  skip: true,
  threshold: :low,
  verbose: false,
  version: false
]