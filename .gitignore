# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
pukllay_club-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Kamal deploy secrets — never committed; values are $VAR-substituted at
# deploy time from GitHub Actions repo secrets (D-08). The CI deploy job
# writes this file fresh on the runner (see .github/workflows/deploy.yml)
# since a fresh checkout never has it.
/.kamal/secrets

# Dev-machine secret config for the one-time D-02 catalog seed task (BGG
# Bearer token + Cloudflare R2 credentials). Deliberately NOT routed through
# Kamal — the seed task never runs on the production host (01-RESEARCH.md
# Pitfall 6). Copy config/dev.secret.exs.example to create this file locally.
/config/dev.secret.exs

# Dialyzer PLTs are locally built (can take several minutes to regenerate)
# and embed absolute local paths + full compiled-module analysis — never
# commit them, especially since this repo is public (D-19).
/priv/plts/*.plt
/priv/plts/*.plt.hash

# GSD workflow runtime state — ephemeral per-session lock/sentinel files,
# not project content.
/.gsd/
/.planning/milestone.lock

